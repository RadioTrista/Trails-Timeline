---
import { getCollection } from "astro:content";
import { type EventDate, formatDate, sortKey } from "../scripts/date";

const rawEvents = await getCollection("events");

// Sort once on the server and serialize only what the client needs to render.
const events = rawEvents
    .map(
        (entry: {
            id: string;
            data: { title: string; date: EventDate; summary: string };
        }) => ({
            id: entry.id,
            title: entry.data.title,
            dateLabel: formatDate(entry.data.date),
            summary: entry.data.summary,
            key: sortKey(entry.data.date),
        }),
    )
    .sort((a: { key: number }, b: { key: number }) => a.key - b.key);
---

<section class="timeline-viewport" aria-label="Interactive timeline">
    <div id="timeline-root" data-events={JSON.stringify(events)}></div>
</section>

<style>
    .timeline-viewport {
        background: var(--color-parchment);
        padding: 32px 16px 48px;
        overflow-x: auto;
        mask-image: linear-gradient(
            90deg,
            transparent 0,
            black 24px,
            black calc(100% - 24px),
            transparent 100%
        );
    }

    :global(.timeline-axis path),
    :global(.timeline-axis line) {
        stroke: var(--color-gold);
    }

    :global(.timeline-axis text) {
        font-family: var(--font-mono);
        font-size: 11px;
        fill: var(--color-ink);
    }

    :global(.event-marker) {
        fill: var(--color-burgundy);
        stroke: var(--color-parchment);
        stroke-width: 1.5px;
        cursor: pointer;
        transition: r 0.15s ease;
    }

    :global(.event-marker:hover),
    :global(.event-marker:focus-visible) {
        r: 7;
        outline: none;
    }

    :global(.event-label) {
        font-family: var(--font-display);
        font-size: 12px;
        fill: var(--color-ink);
        pointer-events: none;
    }
</style>

<script>
    import * as d3 from "d3";

    interface RenderEvent {
        id: string;
        title: string;
        dateLabel: string;
        key: number;
    }

    const root = document.getElementById("timeline-root");

    if (!root) {
        throw new Error("timeline-root not found");
    }

    const events: RenderEvent[] = JSON.parse(root.dataset.events ?? "[]");

    // Minimum horizontal pixels between adjacent event markers before
    // they are crowded and stagger into a different lane.
    const MIN_MARKER_SPACING = 90;
    const LANE_COUNT = 4;
    const LANE_HEIGHT = 34;
    const LABEL_MAX_WIDTH = 84;
    const CANVAS_PADDING = 16;
    // "Nice" round year intervals to snap ticks to.
    const YEAR_STEPS = [1, 2, 5, 10, 25, 50, 100, 250, 500, 1000];
    const TARGET_TICK_SPACING_PX = 110;
    // Gaps up to a year apart get proportional spacing; beyond that, spacing
    // grows logarithmically so a few centuries-wide outliers don't stretch
    // the whole axis and crowd dense clusters together.
    const GAP_LINEAR_CAP_DAYS = 400;
    const GAP_PIXELS_PER_DAY = 0.6;
    const GAP_LOG_SCALE = 40;

    function compressGap(gapDays: number) {
        const linear =
            Math.min(gapDays, GAP_LINEAR_CAP_DAYS) * GAP_PIXELS_PER_DAY;
        const overflow = Math.max(gapDays - GAP_LINEAR_CAP_DAYS, 0);
        const compressed = Math.log1p(overflow) * GAP_LOG_SCALE;
        return Math.max(MIN_MARKER_SPACING, linear + compressed);
    }

    // Wraps each text node's full content into multiple centered tspans,
    // growing away from the baseline (dir) instead of overflowing sideways.
    function wrapText(
        selection: d3.Selection<
            SVGTextElement,
            RenderEvent,
            SVGGElement,
            unknown
        >,
        direction: (timelineEvent: RenderEvent, index: number) => 1 | -1,
    ) {
        const lineHeight = 13;

        selection.each(function (timelineEvent, index) {
            const text = d3.select(this);
            const words = timelineEvent.title
                .split(/\s+/)
                .filter(Boolean)
                .reverse();
            const baseY = Number(text.attr("y"));
            const dir = direction(timelineEvent, index);

            // First pass: measure into a scratch tspan to find the line breaks.
            text.text(null);
            const measure = text.append("tspan").attr("x", 0).attr("y", baseY);
            const lines: string[] = [];
            let line: string[] = [];
            let word: string | undefined;

            while ((word = words.pop())) {
                line.push(word);
                measure.text(line.join(" "));

                if (
                    line.length > 1 &&
                    measure.node()!.getComputedTextLength() > LABEL_MAX_WIDTH
                ) {
                    line.pop();
                    lines.push(line.join(" "));
                    line = [word];
                }
            }
            lines.push(line.join(" "));
            measure.remove();

            // Second pass: place lines so they read top-to-bottom regardless
            // of which way the label grows — the line nearest the marker
            // should always be the last line of text, not the first.
            lines.forEach((content, i) => {
                const distance = dir === 1 ? i : lines.length - 1 - i;
                text.append("tspan")
                    .attr("x", 0)
                    .attr("y", baseY + dir * distance * lineHeight)
                    .text(content);
            });
        });
    }

    function render() {
        root!.innerHTML = "";

        const margin = { left: 24, right: 24 };
        // Reference y for lane math only — the canvas is fitted to the
        // rendered content afterward, so this doesn't need to be a real height.
        const baseline = 0;

        const uniqueKeys = [...new Set(events.map((e) => e.key))];

        // Position events along a compressed scale rather than true linear
        // time — see compressGap above.
        let x: d3.ScaleLinear<number, number>;
        let lastPixel: number;

        const pixelPoints = [margin.left];

        for (let i = 1; i < uniqueKeys.length; i++) {
            const gapDays = uniqueKeys[i] - uniqueKeys[i - 1];
            pixelPoints.push(pixelPoints[i - 1] + compressGap(gapDays));
        }

        lastPixel = pixelPoints[pixelPoints.length - 1];
        x = d3.scaleLinear().domain(uniqueKeys).range(pixelPoints);

        // Sample evenly across the compressed pixel axis rather than picking
        // one year step for the whole (possibly huge) domain — each sample
        // snaps to a "nice" step sized to how compressed that part of the
        // axis is, so dense clusters get fine ticks and empty spans get
        // coarse ones instead of a single tick count starving both.
        const sampleCount = Math.max(
            2,
            Math.round((lastPixel - margin.left) / TARGET_TICK_SPACING_PX),
        );
        const tickYearSet = new Set<number>();

        for (let i = 0; i <= sampleCount; i++) {
            const pixel =
                margin.left + (i * (lastPixel - margin.left)) / sampleCount;
            const sampleKey = x.invert(pixel);
            const neighborKey = x.invert(pixel + TARGET_TICK_SPACING_PX);
            const localSpanYears = Math.max(
                1,
                Math.abs(neighborKey - sampleKey) / 365,
            );
            const localStep =
                YEAR_STEPS.find((step) => step >= localSpanYears) ??
                YEAR_STEPS[YEAR_STEPS.length - 1];

            tickYearSet.add(
                Math.round(sampleKey / 365 / localStep) * localStep,
            );
        }

        const tickYears = [...tickYearSet].sort((a, b) => a - b);

        const laneLastX: number[] = new Array(LANE_COUNT).fill(-Infinity);
        const laneOf = new Map<number, number>();

        events.forEach((timelineEvent: RenderEvent, index: number) => {
            const xPos = x(timelineEvent.key);
            let bestLane = 0;
            let bestGap = -Infinity;
            for (let lane = 0; lane < LANE_COUNT; lane++) {
                const gap = xPos - laneLastX[lane];

                if (gap > bestGap) {
                    bestGap = gap;
                    bestLane = lane;
                }
            }
            laneOf.set(index, bestLane);
            laneLastX[bestLane] = xPos;
        });

        // Alternate lanes above/below the baseline so labels fan out in both
        // directions rather than stacking upward only.
        function laneOffset(index: number) {
            const lane = laneOf.get(index) ?? 0;
            const direction = lane % 2 === 0 ? -1 : 1;
            const laneDepth = Math.ceil((lane + 1) / 2);
            return direction * laneDepth * LANE_HEIGHT * 0.6;
        }

        const svg = d3.select(root).append("svg");
        const chart = svg.append("g").attr("class", "chart-content");

        // Year ticks can round outward past the event domain (e.g. the last
        // event falling mid-year rounds up to the next year boundary), so the
        // baseline needs to reach whichever is furthest: the events or the ticks.
        const lineX1 = Math.min(margin.left, x(tickYears[0] * 365 + 1));
        const lineX2 = Math.max(
            lastPixel,
            x(tickYears[tickYears.length - 1] * 365 + 1),
        );

        // Baseline axis line
        chart
            .append("line")
            .attr("x1", lineX1)
            .attr("x2", lineX2)
            .attr("y1", baseline)
            .attr("y2", baseline)
            .attr("stroke", "var(--color-gold)")
            .attr("stroke-width", 1);

        // Year markers along the baseline
        const yearTick = chart
            .append("g")
            .attr("class", "timeline-axis")
            .selectAll("g.year-tick")
            .data(tickYears)
            .join("g")
            .attr("class", "year-tick")
            .attr(
                "transform",
                (year: number) =>
                    `translate(${x(year * 365 + 1)}, ${baseline})`,
            );

        yearTick.append("line").attr("y1", -4).attr("y2", 4);
        yearTick
            .append("text")
            .attr("y", 16)
            .attr("text-anchor", "middle")
            .text((year: number) => `S.${year}`);

        // Event markers
        const marker = chart
            .selectAll("g.event")
            .data(events)
            .join("g")
            .attr("class", "event")
            .attr("transform", (timelineEvent: RenderEvent, index: number) => {
                const y = baseline + laneOffset(index);
                return `translate(${x(timelineEvent.key)}, ${y})`;
            });

        // Faint connector from each marker back down to the baseline, so
        // staggered events still visually read as belonging to the same axis.
        marker
            .append("line")
            .attr("class", "lane-line")
            .attr("x1", 0)
            .attr("x2", 0)
            .attr("y1", 0)
            .attr(
                "y2",
                (_timelineEvent: RenderEvent, index: number) =>
                    -laneOffset(index),
            );

        marker
            .append("circle")
            .attr("class", "event-marker")
            .attr("r", 5)
            .attr("tabindex", 0)
            .attr("role", "button")
            .attr(
                "aria-label",
                (timelineEvent: RenderEvent) =>
                    `${timelineEvent.title}, ${timelineEvent.dateLabel}`,
            )
            .on("click", (_event: MouseEvent, timelineEvent: RenderEvent) => {
                window.dispatchEvent(
                    new CustomEvent("timeline:select", {
                        detail: timelineEvent,
                    }),
                );
            })
            .on(
                "keydown",
                (event: KeyboardEvent, timelineEvent: RenderEvent) => {
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        window.dispatchEvent(
                            new CustomEvent("timeline:select", {
                                detail: timelineEvent,
                            }),
                        );
                    }
                },
            );

        marker
            .append("text")
            .attr("class", "event-label")
            .attr("y", (_timelineEvent: RenderEvent, index: number) =>
                laneOffset(index) < 0 ? -12 : 22,
            )
            .attr("text-anchor", "middle")
            .call(wrapText, (_timelineEvent, index) =>
                laneOffset(index) < 0 ? -1 : 1,
            );

        // Fit the canvas to the rendered content instead of guessing fixed
        // dimensions, since un-truncated, wrapped labels vary in size.
        const bbox = (chart.node() as SVGGElement).getBBox();
        const canvasWidth = bbox.width + CANVAS_PADDING * 2;
        const canvasHeight = bbox.height + CANVAS_PADDING * 2;

        chart.attr(
            "transform",
            `translate(${CANVAS_PADDING - bbox.x}, ${CANVAS_PADDING - bbox.y})`,
        );
        svg.attr("width", canvasWidth)
            .attr("height", canvasHeight)
            .attr("viewBox", `0 0 ${canvasWidth} ${canvasHeight}`);
    }

    render();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(render, 150);
    });
</script>
